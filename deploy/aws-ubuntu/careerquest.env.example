# Copy to /etc/careerquest-matcher.env on the Ubuntu server, then replace placeholder values.
# Keep this file out of version control and readable only by root and the careerquest service account.

# Required for AI career insights and the CareerQuest assistant outside Manus-managed hosting.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# The Node app is reverse-proxied by Nginx; do not expose this internal port in the AWS security group.
PORT=3000
NODE_ENV=production

# Optional only if you enable the supplied OAuth/database capabilities on the self-hosted instance.
# DATABASE_URL=mysql://user:password@host:3306/database
# JWT_SECRET=replace-with-a-long-random-secret
# VITE_APP_ID=
# OAUTH_SERVER_URL=
# VITE_OAUTH_PORTAL_URL=
