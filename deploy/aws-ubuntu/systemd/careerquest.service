[Unit]
Description=CareerQuest Matcher Node service
After=network.target

[Service]
Type=simple
User=careerquest
Group=careerquest
WorkingDirectory=/opt/careerquest-matcher
EnvironmentFile=/etc/careerquest-matcher.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node /opt/careerquest-matcher/dist/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/careerquest-matcher

[Install]
WantedBy=multi-user.target
